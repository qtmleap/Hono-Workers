  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "wrangler": "^4.80.0"
  }
