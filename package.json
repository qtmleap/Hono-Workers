  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.2"
  }
